/// STM32F4 I2C controller (MMIO). I2C1 / I2C2 / I2C3 on F411/F401-class.
/// No hidden clock — caller passes `i2c_clk_hz` (APB1 after divider) and `freq_hz`.
module machine_stm32

pub struct I2c {
    cr1: *mut volatile i32
    dr: *mut volatile i32
    dr_u8: *mut volatile u8
    sr1: *mut volatile i32
    sr2: *mut volatile i32
}

/// CCR value: Sm (`freq_hz` ≤ 100k) CCR = clk/(2*freq); Fm CCR = clk/(3*freq) + FS.
fn i2c_ccr(i2c_clk_hz: i32, freq_hz: i32): i32 {
    let mut clk = i2c_clk_hz
    if clk < 1 {
        clk = 1
    }
    let mut f = freq_hz
    if f < 1 {
        f = 1
    }
    if f <= 100000 {
        let mut ccr = clk / (2 * f)
        if ccr < 4 {
            ccr = 4
        }
        if ccr > 4095 {
            ccr = 4095
        }
        return ccr
    }
    let mut ccr = clk / (3 * f)
    if ccr < 1 {
        ccr = 1
    }
    if ccr > 4095 {
        ccr = 4095
    }
    return ccr | (1 << 15)
}

/// TRISE: Sm = FREQ_MHz+1; Fm ≈ FREQ_MHz*300/1000+1.
fn i2c_trise(i2c_clk_hz: i32, freq_hz: i32): i32 {
    let mut mhz = i2c_clk_hz / 1000000
    if mhz < 2 {
        mhz = 2
    }
    if mhz > 50 {
        mhz = 50
    }
    if freq_hz <= 100000 {
        return mhz + 1
    }
    return (mhz * 300) / 1000 + 1
}

fn i2c_base(i2c: i32): i32 {
    if i2c == 2 {
        return 0x40005800
    }
    if i2c == 3 {
        return 0x40005C00
    }
    return 0x40005400
}

fn i2c_enable_clock(i2c: i32) {
    let enr = rcc_apb1enr()
    if i2c == 2 {
        *enr = *enr | (1 << 22)
        return
    }
    if i2c == 3 {
        *enr = *enr | (1 << 23)
        return
    }
    *enr = *enr | (1 << 21)
}

fn gpio_set_af_od_pu(port: Port, num: i32, af: i32) {
    gpio_set_af(port, num, af)
    let base = gpio_base(port)
    let otyper = cast(*mut volatile i32, base + 0x04)
    *otyper = *otyper | (1 << num)
    let pupdr = cast(*mut volatile i32, base + 0x0C)
    let shift = num * 2
    // pull-up
    *pupdr = (*pupdr & ~(3 << shift)) | (1 << shift)
}

fn i2c_wait_sr1(sr1: *mut volatile i32, mask: i32) {
    while (*sr1 & mask) == 0 {
    }
}

/// Configure I2C `i2c` (1..=3) on SCL/SDA with explicit AF and APB clock.
/// Standard mode if `freq_hz` ≤ 100000, else fast mode. 7-bit addresses.
/// Common Nucleo Arduino I2C1: PB8/PB9 AF4, HSI → `i2c_clk_hz=16_000_000`.
pub fn i2c_out(
    i2c: i32,
    scl_port: Port,
    scl_num: i32,
    scl_af: i32,
    sda_port: Port,
    sda_num: i32,
    sda_af: i32,
    i2c_clk_hz: i32,
    freq_hz: i32
): I2c {
    gpio_set_af_od_pu(scl_port, scl_num, scl_af)
    gpio_set_af_od_pu(sda_port, sda_num, sda_af)
    i2c_enable_clock(i2c)

    let base = i2c_base(i2c)
    let cr1 = cast(*mut volatile i32, base)
    let cr2 = cast(*mut volatile i32, base + 0x04)
    let dr = cast(*mut volatile i32, base + 0x10)
    let dr_u8 = cast(*mut volatile u8, base + 0x10)
    let sr1 = cast(*mut volatile i32, base + 0x14)
    let sr2 = cast(*mut volatile i32, base + 0x18)
    let ccr = cast(*mut volatile i32, base + 0x1C)
    let trise = cast(*mut volatile i32, base + 0x20)

    *cr1 = 0
    let mut mhz = i2c_clk_hz / 1000000
    if mhz < 2 {
        mhz = 2
    }
    if mhz > 50 {
        mhz = 50
    }
    *cr2 = mhz
    *ccr = i2c_ccr(i2c_clk_hz, freq_hz)
    *trise = i2c_trise(i2c_clk_hz, freq_hz)
    // PE
    *cr1 = 1

    return I2c{ cr1: cr1, dr: dr, dr_u8: dr_u8, sr1: sr1, sr2: sr2 }
}

fn i2c_start_addr(bus: I2c, addr7: i32, read: i32) {
    // START
    *(bus.cr1) = *(bus.cr1) | (1 << 8)
    i2c_wait_sr1(bus.sr1, 1)
    let mut a = (addr7 & 127) << 1
    if read != 0 {
        a = a | 1
    }
    *(bus.dr) = a
    // ADDR
    i2c_wait_sr1(bus.sr1, 1 << 1)
}

/// Blocking write `buf` to 7-bit `addr` (STOP after).
pub fn (bus: I2c) writeto(addr: i32, buf: []u8) {
    i2c_start_addr(bus, addr, 0)
    // clear ADDR by reading SR2
    let _sr2 = *(bus.sr2)
    let mut i: i32 = 0
    while i < buf.len {
        i2c_wait_sr1(bus.sr1, 1 << 7)
        *(bus.dr_u8) = buf[i]
        i = i + 1
    }
    // BTF
    i2c_wait_sr1(bus.sr1, 1 << 2)
    // STOP
    *(bus.cr1) = *(bus.cr1) | (1 << 9)
}

/// Blocking read into `buf` from 7-bit `addr` (len = `buf.len`).
pub fn (bus: I2c) readfrom_into(addr: i32, buf: []u8) {
    let n = buf.len
    if n < 1 {
        return
    }
    if n == 1 {
        // NACK before ADDR clear for single-byte read
        *(bus.cr1) = *(bus.cr1) & ~(1 << 10)
        i2c_start_addr(bus, addr, 1)
        let _sr2 = *(bus.sr2)
        *(bus.cr1) = *(bus.cr1) | (1 << 9)
        i2c_wait_sr1(bus.sr1, 1 << 6)
        buf[0] = *(bus.dr_u8)
        return
    }
    // ACK
    *(bus.cr1) = *(bus.cr1) | (1 << 10)
    i2c_start_addr(bus, addr, 1)
    let _sr2b = *(bus.sr2)
    let mut i: i32 = 0
    while i < n - 2 {
        i2c_wait_sr1(bus.sr1, 1 << 6)
        buf[i] = *(bus.dr_u8)
        i = i + 1
    }
    i2c_wait_sr1(bus.sr1, 1 << 6)
    // NACK before last-1 read completes path to STOP
    *(bus.cr1) = *(bus.cr1) & ~(1 << 10)
    buf[n - 2] = *(bus.dr_u8)
    *(bus.cr1) = *(bus.cr1) | (1 << 9)
    i2c_wait_sr1(bus.sr1, 1 << 6)
    buf[n - 1] = *(bus.dr_u8)
}

/// Write one byte then read `buf` (restart) — common register read pattern.
pub fn (bus: I2c) write_readfrom_into(addr: i32, w: i32, buf: []u8) {
    i2c_start_addr(bus, addr, 0)
    let _sr2 = *(bus.sr2)
    i2c_wait_sr1(bus.sr1, 1 << 7)
    *(bus.dr) = w & 255
    i2c_wait_sr1(bus.sr1, 1 << 2)
    bus.readfrom_into(addr, buf)
}

/// Disable I2C (clear CR1). Does not touch GPIO.
pub fn (bus: I2c) deinit() {
    *(bus.cr1) = 0
}
