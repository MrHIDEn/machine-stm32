// Nucleo-F411RE user LED = PA5, driven through machine_stm32.Pin.
import "../../machine_stm32" machine

@[link("startup.s")]
fn main() {
    let led = machine.pin_out(machine.Port.A, 5)
    while true {
        led.toggle()
        // Busy-wait (~HSI 16 MHz; tune for visible blink on hardware).
        let mut i: i32 = 0
        while i < 1000000 {
            i = i + 1
        }
    }
}
